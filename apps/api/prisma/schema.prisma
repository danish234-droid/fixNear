// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PROFESSIONAL
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  professionalProfile ProfessionalProfile?
  bookings            Booking[]            @relation("CustomerBookings")
  reviews             Review[]             @relation("CustomerReviews")

  @@index([role])
}

model ProfessionalProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  businessName    String?
  bio             String?
  city            String
  address         String?
  profileImageUrl String?
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  services ProfessionalService[]
  reviews  Review[]              @relation("ProfessionalReviews")

  @@index([city])
  @@index([isAvailable])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  services ProfessionalService[]
}

model ProfessionalService {
  id                    String   @id @default(cuid())
  professionalProfileId String
  serviceCategoryId     String
  title                 String
  description           String?
  priceFrom             Decimal? @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  serviceCategory     ServiceCategory     @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  bookings            Booking[]

  @@index([professionalProfileId])
  @@index([serviceCategoryId])
}

model Booking {
  id                    String        @id @default(cuid())
  customerId            String
  professionalServiceId String
  scheduledAt           DateTime?
  address               String
  description           String?
  status                BookingStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer            User                @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  professionalService ProfessionalService @relation(fields: [professionalServiceId], references: [id], onDelete: Restrict)
  review              Review?

  @@index([customerId])
  @@index([professionalServiceId])
  @@index([status])
  @@index([scheduledAt])
  @@index([customerId, status])
}

model Review {
  id                    String   @id @default(cuid())
  bookingId             String   @unique
  customerId            String
  professionalProfileId String
  rating                Int
  comment               String?
  createdAt             DateTime @default(now())

  booking             Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer            User                @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation("ProfessionalReviews", fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([professionalProfileId])
  @@index([rating])
}
