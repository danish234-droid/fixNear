PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# PostgreSQL connection string placeholder
# Format: postgresql://USERNAME:PASSWORD@localhost:5432/fixnear?schema=public
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/fixnear?schema=public"

# JWT signing secret — minimum 32 random characters. DO NOT commit a real secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_HEX_VALUE"
